rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // Reports - authenticated users can read all, write only their own
    match /reports/{docId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.userEmail == request.auth.token.email;
      allow delete: if isAuth() && resource.data.userEmail == request.auth.token.email;
      allow update: if false;
    }

    match /emiReports/{docId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.userEmail == request.auth.token.email;
      allow delete: if isAuth() && resource.data.userEmail == request.auth.token.email;
      allow update: if false;
    }

    match /eligibilityReports/{docId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.userEmail == request.auth.token.email;
      allow delete: if isAuth() && resource.data.userEmail == request.auth.token.email;
      allow update: if false;
    }

    match /aiChats/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if false;
    }

    match /goals/{docId} {
      allow read: if isAuth();
      allow create, update: if isAuth();
      allow delete: if isAuth() && resource.data.userEmail == request.auth.token.email;
    }

    match /recommendations/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if false;
    }

    match /leaderboard/{userId} {
      allow read: if isAuth();
      allow create, update: if isAuth() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
